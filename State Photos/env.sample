# Copy to .env and fill in values.

# Optional. If unset, the app uses SQLite at local_dev.db for local testing only.
# For SQL Server, set DATABASE_URL, for example:
# DATABASE_URL=mssql+pyodbc://USERNAME:PASSWORD@SERVERNAME/DATABASE?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
DATABASE_URL=

# Optional: Flask session / CSRF (if you add auth later)
SECRET_KEY=change-me-to-a-random-string

# Mount path on the public site (default /statephotos). Set empty to serve at site root.
# STATE_PHOTOS_URL_PREFIX=/statephotos
