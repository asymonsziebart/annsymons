# Required – Neon Postgres connection string
# Get this from your Neon project: Connection string with ?sslmode=require
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Required for Family History questionnaire answers – Microsoft SQL Server / Azure SQL
# Either provide one connection string:
# MSSQL_CONNECTION_STRING=Server=tcp:host,1433;Database=database;User Id=user;Password=password;Encrypt=true
# Or provide the individual settings:
MSSQL_SERVER=your-server.database.windows.net
MSSQL_DATABASE=your-database
MSSQL_USER=your-user
MSSQL_PASSWORD=your-password
# MSSQL_PORT=1433
# MSSQL_ENCRYPT=true
# Only enable for local/self-signed development certificates:
# MSSQL_TRUST_SERVER_CERTIFICATE=false

# Required – seeds / syncs the super-admin password for OWNER_EMAIL on first login.
# Admin login is username (email) + password. Super admin email defaults to a.krause10597@gmail.com.
ADMIN_PASSWORD=your-secret-password
# Optional override for the super-admin email (default: a.krause10597@gmail.com)
# OWNER_EMAIL=a.krause10597@gmail.com

# Password for the private /tasks app. If unset, ADMIN_PASSWORD is used (same login as /admin).
TASKS_PASSWORD=your-tasks-password
# Optional second full-access user (Tim). Unlocks /tasks and all admin apps (/admin, blog, statephotos, etc.).
# Set a strong value in production (Vercel env), then redeploy.
# TASKS_PASSWORD_TIM=

# Email via Resend (https://resend.com — free tier).
# Used for overdue task digests AND access-request alerts to OWNER_EMAIL (a.krause10597@gmail.com).
RESEND_API_KEY=re_xxxxxxxx
# Overdue task digest recipient. Cron hits /api/cron/tasks-overdue daily.
TASKS_NOTIFY_EMAIL=you@example.com
# Optional — use after you verify a domain in Resend; otherwise Resend’s onboarding sender is used.
# RESEND_FROM_EMAIL=Ann Symons <tasks@yourdomain.com>

# Protect the cron route (Vercel sets this when you add a cron job, or set manually for curl tests)
CRON_SECRET=generate-a-long-random-string

# Required for /statephotos photo uploads on Vercel (Project → Storage → Blob, or vercel blob create).
# Local dev without this token writes files under public/statephotos-uploads/ instead.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Optional — /pollen (hidden page) uses Google Pollen Forecast for Sterling Heights, MI.
# Enable "Pollen API" on your Google Cloud project. Same key as Maps often works.
# GOOGLE_POLLEN_API_KEY=your-key
# If unset, GOOGLE_MAPS_API_KEY is tried as a fallback.

# Instagram posting (/admin/instagram) — Meta app with Instagram Login + content publish.
# Account must be Instagram Business or Creator. Add OAuth redirect URI matching INSTAGRAM_REDIRECT_URI.
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_REDIRECT_URI=https://www.annsymons.com/api/instagram/callback
# NEXT_PUBLIC_SITE_URL=https://www.annsymons.com

# Optional — /admin/pokemon-cards eBay sold-comp lookups.
# Create an app at https://developer.ebay.com/ — client credentials grant.
# Prefer Marketplace Insights (sold history): scope buy.marketplace.insights
# (limited release; otherwise Browse API active listings are used as a fallback).
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# EBAY_ENV=production
# EBAY_MARKETPLACE_ID=EBAY_US
# EBAY_DEV_ID is only used by the legacy Trading API — not needed for these lookups.
# Required to unlock the production keyset (Marketplace Account Deletion endpoint):
# EBAY_VERIFICATION_TOKEN=annsymons-ebay-mad-verify-token-2026-cardfinder
# EBAY_DELETION_ENDPOINT_URL=https://www.annsymons.com/api/ebay/account-deletion

# Optional — /admin/pokemon-cards live camera/upload scan.
# Production: OPENAI_API_KEY (gpt-4o-mini)
# Local Mac: Ollama vision. Default model is llama3.2-vision.
#   ollama pull llama3.2-vision
# OPENAI_API_KEY=
# OPENAI_VISION_MODEL=gpt-4o-mini
# CARD_SCAN_PROVIDER=ollama
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_VISION_MODEL=llama3.2-vision
# Optional — Pokemon TCG API key for sharper set/number matches after a scan.
# POKEMON_TCG_API_KEY=

